# chain-api engine — configuration reference
# Copy to .env and configure. See README.md for full documentation.
# Leave API_KEY and ADMIN_KEY empty on first run — seed generates them once.

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite (dev/MVP — default):
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/chain-api.db

# PostgreSQL (enterprise — uncomment and fill to switch):
#DB_TYPE=postgres
#DATABASE_URL=postgres://chainapi:chainapi_dev@localhost:5433/chainapi
#DB_POOL_MAX=20
#DB_POOL_IDLE_TIMEOUT_MS=30000

# ─── Bitcoin Core ──────────────────────────────────────────────────────────
# Local regtest (btc-test-ui/start.sh): port 18443, password=bitcoin
# Mainnet: port 8332 | Testnet: port 18332
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=bitcoin
BITCOIN_RPC_TIMEOUT_MS=10000
BITCOIN_RPC_MAX_ATTEMPTS=3
BITCOIN_RPC_RETRY_DELAY_MS=1000
# false = v3 architecture (btc-indexer handles deposit detection — recommended)
# true  = legacy FWallet mode (provisions Bitcoin Core wallets per tenant)
BITCOIN_CORE_PROVISIONING_ENABLED=false
BITCOIN_NETWORK=regtest

# ─── Keys / Seed ───────────────────────────────────────────────────────────
API_KEY=                  # Auto-generated if empty (starts with cak_)
ADMIN_KEY=                # Auto-generated if empty (starts with aak_)
TENANT_NAME=Default Tenant

# ─── Deposit confirmations (platform-wide defaults) ────────────────────────
# Per-tenant overrides: PATCH /admin/v1/tenants/:id/config
# { "btcConfirmationsRequired": N, "btcFinalityConfirmations": N }
BTC_DEFAULT_CONFIRMATIONS=1
BTC_FINALITY_CONFIRMATIONS=6

# ─── Workers ───────────────────────────────────────────────────────────────
WORKERS_ENABLED=true
WEBHOOK_DELIVERY_INTERVAL_MS=10000
TX_STATUS_INTERVAL_MS=60000
SWEEP_WORKER_INTERVAL_MS=300000
NODE_HEALTH_CHECK_INTERVAL_MS=30000

# ─── Webhooks ──────────────────────────────────────────────────────────────
WEBHOOK_AUTO_PAUSE_THRESHOLD=10
WEBHOOK_DELIVERY_RETENTION_DAYS=30

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=100

# ─── Logging ───────────────────────────────────────────────────────────────
# Allowed values: debug | info | warn | error
LOG_LEVEL=info

# ─── Customer session auth ─────────────────────────────────────────────────
# SECRET must be at least 32 characters. Generate with: openssl rand -hex 32
CUSTOMER_SESSION_SECRET=change-me-before-production-use-openssl-rand-hex-32
CUSTOMER_SESSION_TTL_SECONDS=3600

# ─── MCP ───────────────────────────────────────────────────────────────────
MCP_ADMIN_ENABLED=false
MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost

# ─── External Signer & Withdrawal Batcher ──────────────────────────────────
BATCH_WORKER_INTERVAL_MS=30000
BATCH_WORKER_MAX_BATCHES_PER_RUN=25
BATCH_WORKER_MAX_BATCHES_PER_TENANT_PER_RUN=5
BATCH_WORKER_MAX_RUN_MS=25000
SIGNING_TASK_TTL_SECONDS=300
SIGNING_TASK_EXPIRY_INTERVAL_MS=60000

# ─── UTXO Locks ────────────────────────────────────────────────────────────
UTXO_LOCK_TTL_SECONDS=900
SWEEP_UTXO_LOCK_TTL_SECONDS=604800

# ─── Bitcoin Fee Cache ─────────────────────────────────────────────────────
BTC_FEE_RATE_CACHE_TTL_MS=30000

# ─── Ethereum adapter (FAZA 3 — uncomment when ETH node is available) ──────
#ETH_NODE_URL=http://127.0.0.1:8545
#ETH_NODE_AUTH=user:password

# ─── Engine Cluster HA (FAZA 4 — uncomment to enable) ─────────────────────
#CLUSTER_ENABLED=false
#ENGINE_URL=http://this-engine.internal:3000
#CLUSTER_PEER_URLS=http://engine-2.internal:3000,http://engine-3.internal:3000
#CLUSTER_HEARTBEAT_INTERVAL_MS=10000
#CLUSTER_LEADER_TTL_MS=30000

# ─── Dev reference only (NOT read by engine — data lives in DB) ────────────
# BTC_DEV_XPUB is written here by start.sh for reference after first seed run.
BTC_DEV_XPUB=
# BTC_DEV_XPRV — NEVER commit. Local dev reference only.
# BTC_DEV_XPRV=
